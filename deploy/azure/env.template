# =============================================================================
# Azure Container Apps — Environment Variables
# =============================================================================
# Fill in your values and source this before running deployment scripts.
# On PowerShell: Get-Content env.template | ForEach-Object { if ($_ -match '^([^#]\S+)=(.*)') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
# =============================================================================

# --- Azure Resource Names (customize these) ---
AZURE_RESOURCE_GROUP=synapse-rg
AZURE_LOCATION=westeurope
AZURE_ACR_NAME=synapseosacr
AZURE_STORAGE_ACCOUNT=synapsestorage
AZURE_FILESHARE_NAME=falkordb-data
AZURE_ACA_ENV=synapse-env

# --- Container App Names ---
BACKEND_APP_NAME=synapse-backend
FRONTEND_APP_NAME=synapse-frontend
FALKORDB_APP_NAME=synapse-falkordb

# --- Image Tags ---
BACKEND_IMAGE_TAG=v1
FRONTEND_IMAGE_TAG=v1

# --- Secrets (FILL THESE IN) ---
GEMINI_API_KEY=your_gemini_api_key_here
FALKORDB_PASSWORD=your_falkordb_password_here
JWT_SECRET_KEY=your_jwt_secret_here

# --- Backend Config ---
DOMAIN_ID=mann_hummel
FALKORDB_GRAPH=synapse

# --- FalkorDB Source (for data migration) ---
# Current FalkorDB host to export data FROM
SOURCE_FALKORDB_HOST=your_current_falkordb_host
SOURCE_FALKORDB_PORT=6379
SOURCE_FALKORDB_PASSWORD=your_current_password
