# =============================================================================
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — your secrets stay local.
# =============================================================================

# Azure subscription (sub-sandbox-dev-01)
subscription_id = "fb01fd65-839e-4a89-9b61-5317cf61e941"

# Existing resource group (already created by IT)
resource_group_name = "rg-codeit-product-advisor-poc-01"

# Region
location = "westeurope"

# Resource names (must be globally unique, lowercase, no hyphens)
acr_name             = "crcodeitproductadvisorpoc01"
storage_account_name = "stcodeitpocfalkordb01"

# Domain config
domain_id = "mann_hummel"

# --- Secrets ---
gemini_api_key    = "YOUR_GEMINI_API_KEY"
openai_api_key    = "YOUR_OPENAI_API_KEY"
falkordb_password = "YOUR_STRONG_PASSWORD"
jwt_secret_key    = "YOUR_JWT_SECRET"

# --- Deploy control ---
# Phase 1: leave false (creates infra only)
# Phase 2: set to true AFTER pushing images to ACR
deploy_apps = false

# Set to true on FIRST deploy to seed graph from backup.
# Requires seed_from_backup.sh next to .tf files.
seed_graph = false

# --- Image tags ---
backend_image_tag  = "v1"
frontend_image_tag = "v1"
